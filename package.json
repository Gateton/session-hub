    "test": "node test/acceptance.mjs",
    "hub": "node bin/sessionhub.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "files": [
    "bin",
    "core",
    "mcp",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "crush",
    "jcode",
    "pi",
    "sessions",
